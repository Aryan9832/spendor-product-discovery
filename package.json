{
  "name": "spendor-product-discovery",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch server/index.mjs",
    "dev:web": "vite",
    "build": "tsc -b && vite build",
    "test": "node --test",
    "start": "node server/index.mjs",
    "import:public-catalog": "node scripts/import-spendor-public-catalog.mjs",
    "import:retailers": "node scripts/import-spendor-retailers.mjs"
    ,"evaluate": "node scripts/evaluate-retrieval.mjs",
    "generate:embeddings": "node scripts/generate-embeddings.mjs",
    "evaluate:hybrid": "node scripts/evaluate-hybrid-retrieval.mjs"
  },
  "dependencies": {
    "express": "^5.1.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  }
}
